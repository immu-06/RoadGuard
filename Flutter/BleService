// ============================================================
// ROADGUARD BLE SERVICE
// ============================================================
//
// BLE FLOW:
//
// ESP32 NODE A
//      ↓
// ROADGUARD BLE
//      ↓
// GATT NOTIFICATION
//      ↓
// FlutterBluePlus

  // ============================================================
  // RESTART BLE SCANNING
  // ============================================================

  void _restartScanning() {
    if (!_isListening) {
      return;
    }

    if (_scanRestartScheduled) {
      return;
    }

    _scanRestartScheduled = true;

    Future.delayed(
      const Duration(
        seconds: 3,
      ),
          () async {
        _scanRestartScheduled = false;

        if (!_isListening) {
          return;
        }

        if (_device != null) {
          return;
        }

        if (_isConnecting) {
          return;
        }

        try {
          print('======================================');
          print(
            '🔄 RESTARTING ROADGUARD BLE SCAN',
          );
          print('======================================');


          if (FlutterBluePlus
              .isScanningNow) {
            print(
              '⚠️ BLE scan already running.',
            );

            return;
          }


          await FlutterBluePlus.startScan(
            timeout:
            const Duration(
              hours: 1,
            ),
          );


          print(
            '✅ BLE SCAN RESTARTED',
          );
        } catch (e) {
          print(
            '⚠️ BLE RESTART FAILED: $e',
          );
        }
      },
    );
  }


  // ============================================================
  // STOP BLE MONITORING
  // ============================================================

  Future<void> stopListening() async {
    print('======================================');
    print(
      '🛑 EXPLICIT ROADGUARD STOP',
    );
    print('======================================');


    _isListening = false;

    _packetBuffer = '';

    _scanRestartScheduled = false;


    // ----------------------------------------------------------
    // CHARACTERISTIC
    // ----------------------------------------------------------

    await _characteristicSub?.cancel();

    _characteristicSub = null;


    // ----------------------------------------------------------
    // CONNECTION
    // ----------------------------------------------------------

    await _connectionSub?.cancel();

    _connectionSub = null;


    // ----------------------------------------------------------
    // SCAN LISTENER
    // ----------------------------------------------------------

    await _scanSub?.cancel();

    _scanSub = null;


    // ----------------------------------------------------------
    // STOP SCAN
    // ----------------------------------------------------------

    try {
      await FlutterBluePlus.stopScan();
    } catch (_) {}


    // ----------------------------------------------------------
    // DISCONNECT DEVICE
    // ----------------------------------------------------------

    if (_device != null) {
      try {
        await _device!.disconnect();
      } catch (_) {}
    }


    _device = null;

    _crashCharacteristic = null;

    _isConnecting = false;


    print(
      '🛑 BLE SCANNING STOPPED',
    );
  }



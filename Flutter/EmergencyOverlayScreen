import 'map_screen.dart';

class EmergencyOverlayScreen extends StatefulWidget {
  final CrashData? crash;

  const EmergencyOverlayScreen({
    super.key,
    this.crash,
  });

  @override
  State<EmergencyOverlayScreen> createState() =>
      _EmergencyOverlayScreenState();
}

class _EmergencyOverlayScreenState
    extends State<EmergencyOverlayScreen> {
  Timer? _timer;

  int _seconds = 0;

  bool _helping = false;

  // ============================================================
  // START GOLDEN HOUR TIMER
  // ============================================================

  void _startHelping() {
    setState(() {
      _helping = true;
      _seconds = 0;
    });

    _timer?.cancel();

    _timer = Timer.periodic(
      const Duration(seconds: 1),
          (_) {
        if (!mounted) return;

        setState(() {
          _seconds++;
        });
      },
    );

    // Immediately move to First Aid.
    _openFirstAid();
  }

  // ============================================================
  // OPEN FIRST AID
  // ============================================================

  void _openFirstAid() {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => FirstAidScreen(
          crash: widget.crash,
          languageCode: 'en',
        ),
      ),
    );
  }

  // ============================================================
  // CALL 112
  // ============================================================

  Future<void> _call112() async {
    final uri = Uri.parse('tel:112');

    try {
      await launchUrl(uri);
    } catch (_) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Unable to open the phone dialer.',
          ),
        ),
      );
    }
  }

  // ============================================================
  // CALL HOSPITAL
  // ============================================================

  Future<void> _callHospital() async {
    final phone =
        widget.crash?.nearestHospitalPhone;

    if (phone == null || phone.isEmpty) {
      return;
    }

    final uri = Uri.parse('tel:$phone');

    try {
      await launchUrl(uri);
    } catch (_) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Unable to open the phone dialer.',
          ),
        ),
      );
    }
  }

  // ============================================================
  // OPEN GOOGLE MAPS
  // ============================================================

  Future<void> _openMap() async {
    final crash = widget.crash;

    if (crash == null) {
      return;
    }

    final uri = Uri.parse(
      'https://maps.google.com/?q=${crash.lat},${crash.lng}',
    );

    try {
      await launchUrl(
        uri,
        mode: LaunchMode.externalApplication,
      );
    } catch (_) {
      if (!mounted) return;

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Unable to open maps.',
          ),
        ),
      );
    }
  }

  // ============================================================
  // OPEN IN-APP OFFLINE MAP
  // ============================================================

  void _openOfflineMap() {
    final crash = widget.crash;

    if (crash == null) {
      return;
    }

    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (_) => MapScreen(
          crashLatitude: crash.lat,
          crashLongitude: crash.lng,
          crashId: crash.crashId,
        ),
      ),
    );
  }


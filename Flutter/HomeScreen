class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {

  // ============================================================
  // SERVICES
  // ============================================================

  final _bleService = BleService();
  final _mlService = MlService();

  bool _isStartingMonitoring = false;
  bool _monitoringStarted = false;

  // ============================================================
  // INITIALIZE
  // ============================================================

  @override
  void initState() {
    super.initState();

    _startMonitoring();

    _initializeAI();
  }

  // ============================================================
  // INITIALIZE OFFLINE AI
  // ============================================================

  Future<void> _initializeAI() async {
    try {
      await _mlService.initialize();

      if (!mounted) return;

      setState(() {});

      debugPrint(
        '======================================',
      );

      debugPrint(
        '✅ OFFLINE AI MODEL READY',
      );

      debugPrint(
        '======================================',
      );
    } catch (e, stackTrace) {

      debugPrint(
        '======================================',
      );

      debugPrint(
        '❌ AI MODEL INITIALIZATION FAILED',
      );

      debugPrint(
        'ERROR: $e',
      );

      debugPrint(
        'STACK: $stackTrace',
      );

      debugPrint(
        '======================================',
      );
    }
  }
  // ============================================================
// START FOREGROUND BLE SERVICE
// ============================================================

  Future<void> startBleForegroundService() async {
    debugPrint('🚀 Starting foreground service...');

    await FlutterForegroundTask.startService(
      notificationTitle: 'Crash Alert',
      notificationText: 'Monitoring nearby RoadGuard devices',
      callback: startCallback,
    );

    debugPrint('✅ startService() completed');
  }

  // ============================================================
  // START CRASH MONITORING
  // ============================================================

  Future<void> _startMonitoring() async {

    if (_isStartingMonitoring ||
        _monitoringStarted) {
      return;
    }

    if (!mounted) return;

    setState(() {
      _isStartingMonitoring = true;
    });

    try {

      debugPrint(
        '======================================',
      );

      debugPrint(
        'STARTING CRASH MONITORING',
      );

      debugPrint(
        '======================================',
      );

      // --------------------------------------------------------
      // STEP 1
      // Request Bluetooth permissions.
      // --------------------------------------------------------

      debugPrint(
        'Requesting Bluetooth permissions...',
      );

      await _bleService.requestPermissions();

      debugPrint(
        'Bluetooth permission request completed.',
      );

      // --------------------------------------------------------
      // STEP 2
      // Start foreground BLE service.
      // --------------------------------------------------------

      debugPrint(
        'Starting foreground BLE service...',
      );

      await startBleForegroundService();

      debugPrint(
        '======================================',
      );

      debugPrint(
        '✅ FOREGROUND BLE SERVICE STARTED',
      );

      debugPrint(
        '======================================',
      );

      if (mounted) {
        setState(() {
          _monitoringStarted = true;
        });
      }

    } catch (e, stackTrace) {

      debugPrint(
        '======================================',
      );

      debugPrint(
        '❌ BLE MONITORING START FAILED',
      );

      debugPrint(
        'ERROR: $e',
      );

      debugPrint(
        'STACK TRACE: $stackTrace',
      );

      debugPrint(
        '======================================',
      );

      if (mounted) {
        ScaffoldMessenger.of(context)
            .showSnackBar(
          SnackBar(
            content: Text(
              'Unable to start crash monitoring: $e',
            ),
            backgroundColor: Colors.red,
          ),
        );
      }

    } finally {

      if (mounted) {
        setState(() {
          _isStartingMonitoring = false;
        });
      }
    }
  }

  // ============================================================
  // RESTART MONITORING
  // ============================================================

  Future<void> _restartMonitoring() async {

    if (!mounted) return;

    setState(() {
      _monitoringStarted = false;
    });

    await _startMonitoring();
  }

  // ============================================================
  // OPEN FIRST AID
  // ============================================================

  void _openFirstAid() {

    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) =>
        const FirstAidScreen(),
      ),
    );
  }

  // ============================================================
  // DISPOSE
  // ============================================================

  @override
  void dispose() {

    // IMPORTANT:
    //
    // Do NOT stop BLE here.
    //
    // The foreground service owns the actual
    // BLE scanner.

    _mlService.dispose();

    super.dispose();
  }


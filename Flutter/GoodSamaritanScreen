import 'package:flutter/material.dart';

class GoodSamaritanScreen extends StatelessWidget {
  const GoodSamaritanScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: CustomScrollView(
        slivers: [
          SliverAppBar(
            expandedHeight: 160,
            pinned: true,
            backgroundColor: const Color(0xFF5C6BC0),
            iconTheme: const IconThemeData(color: Colors.white),
            flexibleSpace: FlexibleSpaceBar(
              titlePadding: const EdgeInsets.only(left: 56, bottom: 16),
              title: const Text('Good Samaritan Law', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 16)),
              background: Container(
                decoration: const BoxDecoration(
                  gradient: LinearGradient(
                    begin: Alignment.topLeft,
                    end: Alignment.bottomRight,
                    colors: [Color(0xFF5C6BC0), Color(0xFF7986CB)],
                  ),
                ),
                child: const Center(
                  child: Icon(Icons.gavel, color: Colors.white24, size: 90),
                ),
              ),
            ),
          ),
          SliverToBoxAdapter(
            child: Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Container(
                    padding: const EdgeInsets.all(16),
                    decoration: BoxDecoration(color: const Color(0xFFE8EAF6), borderRadius: BorderRadius.circular(16)),
                    child: const Text(
                      'India\'s Good Samaritan Law protects anyone who helps an accident '
                          'victim from legal, civil, or procedural harassment. It was given the '
                          '"force of law" by the Supreme Court of India in 2016, and later formally '
                          'added to the Motor Vehicles Act, 1988 as Section 134A (via the 2019 amendment).',
                      style: TextStyle(fontSize: 14, height: 1.5),
                    ),
                  ),
                  const SizedBox(height: 24),
                  const _SectionHeader(icon: Icons.verified_user, color: Color(0xFF5C6BC0), title: 'What the law guarantees you'),
                  const SizedBox(height: 10),
                  const _BulletCard(color: Color(0xFF5C6BC0), text: 'You cannot be held civilly or criminally liable for any injury or death of the victim resulting from your good-faith help — even if something goes wrong while you were assisting.'),
                  const _BulletCard(color: Color(0xFF5C6BC0), text: 'You are not required to disclose your personal details unless you choose to.'),
                  const _BulletCard(color: Color(0xFF5C6BC0), text: 'You cannot be forced to be a witness — and if you agree, you may choose the time and place.'),
                  const _BulletCard(color: Color(0xFF5C6BC0), text: 'Police can only question you once, and only with your consent.'),
                  const _BulletCard(color: Color(0xFF5C6BC0), text: 'Hospitals cannot demand money, personal details, or paperwork before treating the victim.'),
                  const SizedBox(height: 20),
                  const _SectionHeader(icon: Icons.insights, color: Color(0xFFEF5350), title: 'Why this matters'),
                  const SizedBox(height: 10),
                  Container(
                    padding: const EdgeInsets.all(16),
                    decoration: BoxDecoration(color: const Color(0xFFFFEBEE), borderRadius: BorderRadius.circular(16)),
                    child: const Text(
                      'About 50% of road accident deaths could be prevented with timely care '
                          'in the "Golden Hour." This law exists to remove the fear that stops bystanders from helping.',
                      style: TextStyle(fontSize: 13.5, height: 1.5, color: Color(0xFFC62828)),
                    ),
                  ),
                  const SizedBox(height: 20),
                  const _SectionHeader(icon: Icons.card_giftcard, color: Color(0xFF66BB6A), title: 'Rah-Veer reward scheme'),
                  const SizedBox(height: 10),
                  Container(
                    padding: const EdgeInsets.all(16),
                    decoration: BoxDecoration(color: const Color(0xFFE8F5E9), borderRadius: BorderRadius.circular(16)),
                    child: const Text(
                      'The Rah-Veer scheme rewards Good Samaritans who help transport a victim to '
                          'hospital within the first 60 minutes, with cash awards and recognition — no medical training needed.',
                      style: TextStyle(fontSize: 13.5, height: 1.5, color: Color(0xFF2E7D32)),
                    ),
                  ),
                  const SizedBox(height: 24),
                  Container(
                    padding: const EdgeInsets.all(12),
                    decoration: BoxDecoration(color: Colors.grey.shade100, borderRadius: BorderRadius.circular(12)),
                    child: const Text(
                      'This is a general summary for awareness, not legal advice. Verify current details with official government sources if relied upon in a legal situation.',
                      style: TextStyle(fontSize: 11.5, color: Colors.black54),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _SectionHeader extends StatelessWidget {
  final IconData icon;
  final Color color;
  final String title;
  const _SectionHeader({required this.icon, required this.color, required this.title});

  @override
  Widget build(BuildContext context) {
    return Row(
      children: [
        Icon(icon, color: color, size: 20),
        const SizedBox(width: 8),
        Text(title, style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: color)),
      ],
    );
  }
}

class _BulletCard extends StatelessWidget {
  final Color color;
  final String text;
  const _BulletCard({required this.color, required this.text});

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 8),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Container(
            margin: const EdgeInsets.only(top: 5),
            width: 8,
            height: 8,
            decoration: BoxDecoration(color: color, shape: BoxShape.circle),
          ),
          const SizedBox(width: 12),
          Expanded(child: Text(text, style: const TextStyle(fontSize: 13.5, height: 1.4))),
        ],
      ),
    );
  }
}

        content: Text(
          widget.language == 'en'
              ? 'Please use your phone dialer to call 112 immediately.'
              : 'உங்கள் தொலைபேசியைப் பயன்படுத்தி உடனடியாக 112 ஐ அழைக்கவும்.',
        ),
        actions: [
          TextButton(
            onPressed: () =>
                Navigator.pop(context),
            child: const Text('OK'),
          ),
        ],
      ),
    );
  }
}


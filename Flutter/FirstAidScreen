    widget.language == 'ta'
        ? widget.guide['video_ta']
    as String
        : widget.guide['video_en']
    as String;

    final images =
    List<String>.from(
      widget.guide['images'],
    );

    final animation =
    widget.guide['animation'] as String;

    return Container(
      margin:
      const EdgeInsets.only(bottom: 14),
      decoration: BoxDecoration(
        color: bgColor,
        borderRadius:
        BorderRadius.circular(20),
        border: Border.all(
